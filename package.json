    "lodash": "^4.18.1",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
