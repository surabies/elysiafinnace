    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "@iconify/react": "^6.0.4",
    "@shadcn/react": "^0.3.1",
    "@types/lodash": "^4.17.27",
    "@vercel/functions": "^3.11.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
