# Copy to .env (never commit the real file).

# PostgreSQL with the PostGIS extension available.
# Local (docker compose): postgres://app:app_dev_pw@localhost:5432/appdb
# Hosted providers usually need TLS: append ?sslmode=require
# On Vercel prefer the provider's POOLED connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Required. At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more

# Public origin of the app. Required in production.
# Leave UNSET for Vercel Preview deployments (derived from VERCEL_BRANCH_URL / VERCEL_URL).
BETTER_AUTH_URL=http://localhost:3000

# Optional. Comma-separated extra origins allowed to call the API cross-origin
# and to be trusted by Better Auth. Leave empty for same-origin only.
ALLOWED_ORIGINS=

# Optional tuning.
# Max write requests (POST/DELETE) per minute per user/IP on the Elysia API.
WRITE_RATE_LIMIT_MAX=30
# Max connections kept by this runtime instance's pool.
DATABASE_POOL_MAX=5

# Aktifkan dokumentasi API /api/openapi di produksi (default: hanya non-produksi)
# OPENAPI_ENABLED=true

